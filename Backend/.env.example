# Server
NODE_ENV=development
PORT=5000

# MongoDB (Atlas connection string or local)
# Example Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/klyptic?retryWrites=true&w=majority
# Example local: mongodb://127.0.0.1:27017/klyptic
MONGODB_URI=

# JWT — use a long random secret in production (8+ chars required; 32+ recommended)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origin(s), comma-separated if multiple
# TanStack/Vite often uses http://localhost:8080
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# FastAPI AI engine (can stay as default until ai-engine is built)
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_TIMEOUT_MS=60000

# Uploads (bytes) — default 25MB
UPLOAD_MAX_BYTES=26214400
